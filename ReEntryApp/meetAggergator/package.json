{
  "name": "recovery-meeting-finder",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @recovery/api",
    "dev:web": "npm run web --workspace @recovery/client",
    "db:up": "docker compose up -d database",
    "db:migrate": "npm run db:migrate --workspace @recovery/api",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspace @recovery/client",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration.test.ts",
    "build": "tsc -p tsconfig.json && npm run build --workspace @recovery/client",
    "sync:sources": "npm run sync --workspace @recovery/api -- all",
    "test:postgis": "node scripts/test-postgis.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "react-native-worklets": "0.10.1",
    "react-native-reanimated": "4.5.1"
  }
}
