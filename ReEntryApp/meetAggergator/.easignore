# Only the npm workspace manifests, shared package, and mobile app.
/*
!/.easignore
!/package.json
!/package-lock.json
!/tsconfig.json
!/apps
/apps/*
!/apps/client
!/apps/api
/apps/api/*
!/apps/api/package.json
!/packages
/packages/*
!/packages/shared
**/node_modules
**/.git
**/.expo
**/.claude
**/dist
**/dist-native
**/dist-verified
**/.env
**/.env.*
**/auth.json
**/*.jks
**/*.keystore
**/*.pem
**/*.key
**/*.log
